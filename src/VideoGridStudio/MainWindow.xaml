<Window x:Class="MkvPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:controls="clr-namespace:MkvPlayer.Controls"
        Title="Multimedia Player" Height="720" Width="1200" MinWidth="640" MinHeight="420"
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- Dark submenu popups: the default MenuItem template pulls its popup background
             and hover highlight from OS theme brushes, so it ignores the app's dark theme
             unless replaced outright. Two role-specific templates cover the top-level
             headers (File/Tools/Help/VideoCreator, which own the Popup) and their child
             submenu items. -->
        <ControlTemplate x:Key="MenuItemTopLevelHeaderTemplate" TargetType="MenuItem">
            <Border x:Name="Border" Background="{TemplateBinding Background}">
                <Grid>
                    <ContentPresenter Margin="{TemplateBinding Padding}" ContentSource="Header"
                                       RecognizesAccessKey="True" VerticalAlignment="Center"/>
                    <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}"
                           AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1">
                            <ScrollViewer CanContentScroll="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#3F3F46"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="MenuItemTopLevelItemTemplate" TargetType="MenuItem">
            <Border x:Name="Border" Background="{TemplateBinding Background}">
                <ContentPresenter Margin="{TemplateBinding Padding}" ContentSource="Header"
                                   RecognizesAccessKey="True" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#3F3F46"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="MenuItemSubmenuItemTemplate" TargetType="MenuItem">
            <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                   VerticalAlignment="Center" Margin="20,0,8,0"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#3F3F46"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template" Value="{StaticResource MenuItemSubmenuItemTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource MenuItemTopLevelHeaderTemplate}"/>
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Template" Value="{StaticResource MenuItemTopLevelItemTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,4"/>
        </Style>

        <!-- VideoCreator gets its own accent-colored template so it visually stands out from
             the plain File/Tools/Help headers, as a pill-shaped button rather than a flat
             menu item; a lighter shade of the same accent on hover keeps it distinct there too. -->
        <ControlTemplate x:Key="VideoCreatorMenuItemTemplate" TargetType="MenuItem">
            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4" Margin="6,2">
                <ContentPresenter Margin="{TemplateBinding Padding}" ContentSource="Header"
                                   RecognizesAccessKey="True" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#8657E8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="VideoCreatorMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="#6C3CE9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="Template" Value="{StaticResource VideoCreatorMenuItemTemplate}"/>
        </Style>

        <!-- Winamp-style button chrome: a beveled metal cap (light-to-dark gradient, embossed
             top-left highlight) applied to every Button in the window, with the classic
             brighten-on-hover / invert-and-nudge-on-press feedback instead of the flat OS
             button look. Transport buttons additionally swap their text for the classic
             rewind/play/pause/stop/fast-forward glyphs (see the transport bar below). -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#DCEBDD"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bevel" CornerRadius="2" BorderThickness="1" BorderBrush="#0A0A0A">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#6A6A6A" Offset="0"/>
                                    <GradientStop Color="#4A4A4A" Offset="0.45"/>
                                    <GradientStop Color="#2C2C2C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border BorderThickness="1,1,0,0" BorderBrush="#33FFFFFF" CornerRadius="2" Margin="1">
                                <ContentPresenter x:Name="Presenter" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bevel" Property="BorderBrush" Value="#3FB552"/>
                                <Setter TargetName="Bevel" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#7C7C7C" Offset="0"/>
                                            <GradientStop Color="#585858" Offset="0.45"/>
                                            <GradientStop Color="#363636" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bevel" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#222222" Offset="0"/>
                                            <GradientStop Color="#3A3A3A" Offset="0.55"/>
                                            <GradientStop Color="#525252" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Presenter" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="1" Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Subtle multimedia-themed background texture. Kept low-opacity, and every panel
             drawn on top uses a slightly translucent background (see tab content below) so
             this shows through everywhere without ever fighting readability. -->
        <Image Source="pack://application:,,,/Resources/background.png" Stretch="UniformToFill" Opacity="0.55"/>

        <DockPanel LastChildFill="True">

            <Menu DockPanel.Dock="Top" Background="#252526" Foreground="White" Height="26">
                <MenuItem Header="_File" Foreground="White">
                    <MenuItem Header="Add _Video Files..." Click="AddFilesButton_Click"/>
                    <MenuItem Header="Add _Audio Files..." Click="AddAudioFilesButton_Click"/>
                    <MenuItem Header="Add Audio F_older..." Click="AddAudioFolderButton_Click"/>
                    <Separator/>
                    <MenuItem Header="E_xit" Click="ExitMenuItem_Click"/>
                </MenuItem>
                <MenuItem Header="_Tools" Foreground="White">
                    <MenuItem Header="_Preferences..." Click="PreferencesMenuItem_Click"/>
                </MenuItem>
                <MenuItem Header="_Help" Foreground="White">
                    <MenuItem Header="_About Multimedia Player" Click="AboutMenuItem_Click"/>
                </MenuItem>
                <MenuItem Header="_VideoCreator" Style="{StaticResource VideoCreatorMenuItemStyle}" Click="VideoCreatorMenuItem_Click"/>
            </Menu>

            <!-- Shared transport bar: drives the Video tab's LibVLC player or the Audio tab's
                 NAudio engine depending which tab is active. Hidden on the Voice Record tab,
                 which has its own Record/Stop controls. -->
            <Border x:Name="TransportBar" DockPanel.Dock="Bottom" Background="#1E1E1E" Padding="12,8"
                    BorderBrush="#3F3F46" BorderThickness="0,1,0,0">
                <StackPanel>
                    <Slider x:Name="SeekSlider" Minimum="0" Maximum="1000" Value="0"
                            PreviewMouseDown="SeekSlider_PreviewMouseDown"
                            PreviewMouseUp="SeekSlider_PreviewMouseUp"
                            Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PrevButton" Grid.Column="0" Content="&#9664;&#9664;" FontSize="11" Click="PrevButton_Click" Padding="10,4" MinWidth="34" Margin="0,0,4,0" ToolTip="Previous"/>
                        <Button x:Name="Back10Button" Grid.Column="1" Content="&#171;&#160;10s" Click="Back10Button_Click" Padding="10,4" Margin="0,0,4,0"/>
                        <Button x:Name="PlayPauseButton" Grid.Column="2" Content="&#9654;" FontSize="13" Click="PlayPauseButton_Click" Padding="14,4" MinWidth="40" Margin="0,0,4,0" ToolTip="Play / Pause"/>
                        <Button x:Name="StopButton" Grid.Column="3" Content="&#9632;" FontSize="12" Click="StopButton_Click" Padding="12,4" MinWidth="36" Margin="0,0,4,0" ToolTip="Stop"/>
                        <Button x:Name="Fwd10Button" Grid.Column="4" Content="10s&#160;&#187;" Click="Fwd10Button_Click" Padding="10,4" Margin="0,0,4,0"/>
                        <Button x:Name="NextButton" Grid.Column="5" Content="&#9654;&#9654;" FontSize="11" Click="NextButton_Click" Padding="10,4" MinWidth="34" Margin="0,0,14,0" ToolTip="Next"/>
                        <TextBlock x:Name="TimeLabel" Grid.Column="6" Text="00:00 / 00:00" Foreground="White" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock x:Name="NowPlayingLabel" Grid.Column="7" Text="No file loaded" Foreground="#AAAAAA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="KaraokeLabel" Grid.Column="8" Text="Karaoke" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"
                                   ToolTip="Fades vocals out of the current Audio track as you lower it (Audio tab only)"/>
                        <Slider x:Name="KaraokeSlider" Grid.Column="9" Width="100" Minimum="0" Maximum="100" Value="100" ValueChanged="KaraokeSlider_ValueChanged" VerticalAlignment="Center" Margin="0,0,14,0"
                                ToolTip="Fades vocals out of the current Audio track as you lower it (Audio tab only)"/>
                        <TextBlock x:Name="VolumeLabel" Grid.Column="10" Text="Vol 100%" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" MinWidth="60"/>
                        <Slider x:Name="VolumeSlider" Grid.Column="11" Width="100" Minimum="0" Maximum="100" Value="100" ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button x:Name="FullscreenButton" Grid.Column="12" Content="Fullscreen" Click="FullscreenButton_Click" Padding="12,4"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0"
                        SelectionChanged="MainTabControl_SelectionChanged">

                <!-- ===================== Video tab ===================== -->
                <TabItem Header="Video">
                    <Grid Background="#1E1E1E">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="FileListColumn" Width="260" MinWidth="0"/>
                            <ColumnDefinition x:Name="SplitterColumn" Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel x:Name="FileListPanel" Grid.Column="0" Background="#E61E1E1E">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
                                <Button x:Name="AddFilesButton" Content="Add Files" Click="AddFilesButton_Click" Padding="8,4" Margin="0,0,6,0"/>
                                <Button x:Name="RemoveFileButton" Content="Remove" Click="RemoveFileButton_Click" Padding="8,4" Margin="0,0,6,0"/>
                                <Button x:Name="ClearAllFilesButton" Content="Clear All" Click="ClearAllFilesButton_Click" Padding="8,4"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Playlist" Foreground="#AAAAAA" Margin="10,0,0,4" FontSize="11"/>
                            <ListBox x:Name="FileListBox"
                                     Margin="8,0,8,8"
                                     ItemsSource="{Binding MediaFiles}"
                                     DisplayMemberPath="DisplayName"
                                     MouseDoubleClick="FileListBox_MouseDoubleClick"
                                     AllowDrop="True"
                                     Drop="FileListBox_Drop"
                                     Background="#252526"
                                     Foreground="White"
                                     BorderThickness="0"/>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#3F3F46"/>

                        <!-- VideoView hosts the video surface as a native child HWND (see LibVLCSharp.WPF's
                             VideoHwndHost), which paints over any ordinary WPF sibling regardless of z-order:
                             the classic "airspace" problem. VideoView works around this itself: content
                             assigned as its Content (not a Grid sibling) is re-hosted onto a transparent,
                             always-aligned topmost window it manages internally (see LibVLCSharp.WPF's
                             ForegroundWindow), which is the only way anything actually renders on top of it. -->
                        <vlc:VideoView x:Name="VideoViewControl" Grid.Column="2" Background="Black" MouseDoubleClick="VideoViewControl_MouseDoubleClick">
                            <!-- Shown whenever nothing is loaded/playing; hidden the moment PlayVideo starts one,
                                 re-shown on Stop or when the playing item is removed. IsHitTestVisible="False" so
                                 double-click (fullscreen) and everything else still reaches the video below. -->
                            <Border x:Name="VideoPlaceholderOverlay" Background="Transparent" IsHitTestVisible="False">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                                    <Grid Width="120" Height="120" Margin="0,0,0,22" HorizontalAlignment="Center" Opacity="0.16">
                                        <Ellipse Stroke="White" StrokeThickness="4"/>
                                        <Polygon Points="46,35 46,85 88,60" Fill="White"/>
                                    </Grid>
                                    <TextBlock Text="MKV / MP4 Player · Video Grid Studio" Foreground="White" Opacity="0.55" FontSize="22" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Foreground="White" Opacity="0.4" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16">
                                        Video via LibVLC, audio and voice recording via NAudio, a shared 7-band equalizer with karaoke vocal fade, and a VideoCreator grid tool that combines clips into one video -- or a portrait phone status.
                                    </TextBlock>
                                    <TextBlock Text="Add Video Files, or drop files onto the list, to begin" Foreground="White" Opacity="0.32" FontSize="12"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </vlc:VideoView>
                    </Grid>
                </TabItem>

                <!-- ===================== Audio tab ===================== -->
                <TabItem Header="Audio">
                    <Grid Background="#1E1E1E">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0" Background="#E61E1E1E">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,4">
                                <Button x:Name="AddAudioFilesButton" Content="Add Files" Click="AddAudioFilesButton_Click" Padding="8,4" Margin="0,0,6,0"/>
                                <Button x:Name="AddAudioFolderButton" Content="Add Folder" Click="AddAudioFolderButton_Click" Padding="8,4" Margin="0,0,6,0"/>
                                <Button x:Name="RemoveAudioFileButton" Content="Remove" Click="RemoveAudioFileButton_Click" Padding="8,4" Margin="0,0,6,0"/>
                                <Button x:Name="ClearAllAudioFilesButton" Content="Clear All" Click="ClearAllAudioFilesButton_Click" Padding="8,4"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,8,4">
                                <Button x:Name="PlaySelectedAudioButton" Content="Play Selected" Click="PlaySelectedAudioButton_Click" Padding="8,4" Margin="0,0,6,0"/>
                                <Button x:Name="CreatePlaylistButton" Content="Create Playlist" Click="CreatePlaylistButton_Click" Padding="8,4" Margin="0,0,6,0"/>
                                <Button x:Name="LoadPlaylistButton" Content="Load Playlist" Click="LoadPlaylistButton_Click" Padding="8,4"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Select one or more files, then Play or Create Playlist"
                                       Foreground="#AAAAAA" Margin="10,0,8,4" FontSize="11" TextWrapping="Wrap"/>
                            <ListBox x:Name="AudioFileListBox"
                                     Margin="8,0,8,8"
                                     ItemsSource="{Binding AudioFiles}"
                                     DisplayMemberPath="DisplayName"
                                     SelectionMode="Extended"
                                     MouseDoubleClick="AudioFileListBox_MouseDoubleClick"
                                     AllowDrop="True"
                                     Drop="AudioFileListBox_Drop"
                                     Background="#252526"
                                     Foreground="White"
                                     BorderThickness="0"/>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#3F3F46"/>

                        <Border Grid.Column="2" Background="#E6141416" BorderBrush="#3F3F46" BorderThickness="2" CornerRadius="8" Margin="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="OSCILLOSCOPE (click to cycle: fire / spectrum / off)" Foreground="#3F6B36" FontSize="11" FontWeight="Bold" Margin="12,10,12,0"/>
                                <controls:OscilloscopeControl x:Name="Oscilloscope" Grid.Row="1" Margin="12"
                                                               Cursor="Hand" ToolTip="Click to switch view"
                                                               MouseLeftButtonDown="OscilloscopeView_MouseLeftButtonDown"/>
                                <controls:OscilloscopeSpectrumControl x:Name="OscilloscopeSpectrum" Grid.Row="1" Margin="12"
                                                                       Visibility="Collapsed"
                                                                       Cursor="Hand" ToolTip="Click to switch view"
                                                                       MouseLeftButtonDown="OscilloscopeView_MouseLeftButtonDown"/>
                                <Border x:Name="OscilloscopeOffPanel" Grid.Row="1" Margin="12" Background="Transparent"
                                        Visibility="Collapsed"
                                        Cursor="Hand" ToolTip="Click to switch view"
                                        MouseLeftButtonDown="OscilloscopeView_MouseLeftButtonDown">
                                    <TextBlock Text="Visualization off &#8212; click to enable" Foreground="#5A6B5C" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ===================== Voice Record tab ===================== -->
                <TabItem Header="Voice Record">
                    <Grid Background="#1E1E1E">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <Ellipse x:Name="RecordingIndicator" Width="14" Height="14" Fill="#E53935" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0"/>
                                <TextBlock Text="Voice Recorder" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="RecordButton" Content="Record" Width="160" Height="44" FontSize="14"
                                    Click="RecordButton_Click" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock x:Name="RecordingTimeLabel" Text="00:00" Foreground="White" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock x:Name="RecordingStatusLabel"
                                       Text="Press Record to start capturing from your default microphone. The recording is added to the Audio tab automatically when you stop."
                                       Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Transient OSD overlay for volume/seek feedback, faded in/out like VLC's on-screen display -->
        <Border x:Name="OsdBorder" Background="#CC000000" CornerRadius="6" Padding="16,8"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,110"
                Visibility="Collapsed" IsHitTestVisible="False" Opacity="0">
            <TextBlock x:Name="OsdText" Foreground="White" FontSize="16"/>
        </Border>
    </Grid>
</Window>
