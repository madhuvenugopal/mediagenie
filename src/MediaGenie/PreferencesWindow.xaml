<Window x:Class="MkvPlayer.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferences" Height="540" Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">
    <Window.Resources>
        <!-- Same Winamp-style beveled button chrome as the main window's transport bar. -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#DCEBDD"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bevel" CornerRadius="2" BorderThickness="1" BorderBrush="#0A0A0A">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#6A6A6A" Offset="0"/>
                                    <GradientStop Color="#4A4A4A" Offset="0.45"/>
                                    <GradientStop Color="#2C2C2C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border BorderThickness="1,1,0,0" BorderBrush="#33FFFFFF" CornerRadius="2" Margin="1">
                                <ContentPresenter x:Name="Presenter" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bevel" Property="BorderBrush" Value="#3FB552"/>
                                <Setter TargetName="Bevel" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#7C7C7C" Offset="0"/>
                                            <GradientStop Color="#585858" Offset="0.45"/>
                                            <GradientStop Color="#363636" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bevel" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#222222" Offset="0"/>
                                            <GradientStop Color="#3A3A3A" Offset="0.55"/>
                                            <GradientStop Color="#525252" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Presenter" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="1" Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Winamp graphic-EQ fader: a recessed metal groove with a beveled cap thumb, the same
             gradient language as the buttons above, in place of the default OS slider. Built for
             the vertical faders used throughout this window (Preamp + the 7 bands); a thin green
             line at the track's midpoint marks 0 dB, since every fader here is centered on 0. -->
        <Style TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Width="6" HorizontalAlignment="Center" CornerRadius="2"
                                    BorderThickness="1" BorderBrush="#0A0A0A">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0C0C0C" Offset="0"/>
                                        <GradientStop Color="#202020" Offset="0.5"/>
                                        <GradientStop Color="#0C0C0C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Rectangle Width="18" Height="1" Fill="#3F6B36" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="26" Height="14" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Cap" CornerRadius="2" BorderThickness="1" BorderBrush="#0A0A0A">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#8C8C8C" Offset="0"/>
                                                            <GradientStop Color="#5C5C5C" Offset="0.5"/>
                                                            <GradientStop Color="#333333" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Rectangle Height="1" Fill="#40FFFFFF" VerticalAlignment="Top" Margin="2,1,2,0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Cap" Property="BorderBrush" Value="#3FB552"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Equalizer -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Graphic Equalizer" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            <CheckBox x:Name="EqEnabledCheckBox" Content="Enabled" Foreground="White" Margin="20,0,0,0"
                      VerticalAlignment="Center" Checked="EqControl_Changed" Unchecked="EqControl_Changed"/>
            <Button x:Name="ResetEqButton" Content="Reset" Padding="8,2" Margin="20,0,0,0" Click="ResetEqButton_Click"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Preamp -->
                <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Preamp" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
                    <Slider x:Name="PreampSlider" Orientation="Vertical" Height="248" Minimum="-12" Maximum="12" Value="0"
                            TickFrequency="3" IsSnapToTickEnabled="False" ValueChanged="EqSlider_ValueChanged"
                            Margin="0,8,0,12"/>
                    <TextBlock x:Name="PreampValueLabel" Text="0.0 dB" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 7 bands -->
                <UniformGrid Grid.Column="1" Rows="1" Columns="7">
                    <StackPanel x:Name="Band0Panel" Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Text="60 Hz" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
                        <Slider x:Name="Band0Slider" Orientation="Vertical" Height="248" Minimum="-12" Maximum="12" Value="0"
                                ValueChanged="EqSlider_ValueChanged" Margin="0,8,0,12"/>
                        <TextBlock x:Name="Band0ValueLabel" Text="0.0 dB" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel x:Name="Band1Panel" Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Text="310 Hz" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
                        <Slider x:Name="Band1Slider" Orientation="Vertical" Height="248" Minimum="-12" Maximum="12" Value="0"
                                ValueChanged="EqSlider_ValueChanged" Margin="0,8,0,12"/>
                        <TextBlock x:Name="Band1ValueLabel" Text="0.0 dB" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel x:Name="Band2Panel" Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Text="600 Hz" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
                        <Slider x:Name="Band2Slider" Orientation="Vertical" Height="248" Minimum="-12" Maximum="12" Value="0"
                                ValueChanged="EqSlider_ValueChanged" Margin="0,8,0,12"/>
                        <TextBlock x:Name="Band2ValueLabel" Text="0.0 dB" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel x:Name="Band3Panel" Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Text="1 kHz" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
                        <Slider x:Name="Band3Slider" Orientation="Vertical" Height="248" Minimum="-12" Maximum="12" Value="0"
                                ValueChanged="EqSlider_ValueChanged" Margin="0,8,0,12"/>
                        <TextBlock x:Name="Band3ValueLabel" Text="0.0 dB" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel x:Name="Band4Panel" Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Text="3 kHz" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
                        <Slider x:Name="Band4Slider" Orientation="Vertical" Height="248" Minimum="-12" Maximum="12" Value="0"
                                ValueChanged="EqSlider_ValueChanged" Margin="0,8,0,12"/>
                        <TextBlock x:Name="Band4ValueLabel" Text="0.0 dB" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel x:Name="Band5Panel" Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Text="6 kHz" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
                        <Slider x:Name="Band5Slider" Orientation="Vertical" Height="248" Minimum="-12" Maximum="12" Value="0"
                                ValueChanged="EqSlider_ValueChanged" Margin="0,8,0,12"/>
                        <TextBlock x:Name="Band5ValueLabel" Text="0.0 dB" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel x:Name="Band6Panel" Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Text="12 kHz" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
                        <Slider x:Name="Band6Slider" Orientation="Vertical" Height="248" Minimum="-12" Maximum="12" Value="0"
                                ValueChanged="EqSlider_ValueChanged" Margin="0,8,0,12"/>
                        <TextBlock x:Name="Band6ValueLabel" Text="0.0 dB" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Default media folder -->
        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,16,0,0">
            <TextBlock Text="Default media folder" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DefaultFolderTextBox" Grid.Column="0" Padding="6,4" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="Browse..." Padding="10,4" Margin="8,0,0,0" Click="BrowseFolderButton_Click"/>
                <CheckBox x:Name="ApplyMachineWideCheckBox" Grid.Column="2" Content="Apply for all users"
                          Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0"
                          ToolTip="Requires running as administrator. Falls back to just this user if not elevated."/>
            </Grid>
        </StackPanel>

        <!-- Save / Cancel -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Width="90" Padding="8,4" Margin="0,0,8,0" Click="CancelButton_Click" IsCancel="True"/>
            <Button Content="Save" Width="90" Padding="8,4" Click="SaveButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
