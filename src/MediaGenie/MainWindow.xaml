<Window x:Class="MkvPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:controls="clr-namespace:MkvPlayer.Controls"
        Title="MediaGenie" Height="720" Width="1200" MinWidth="640" MinHeight="420"
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- Dark submenu popups: the default MenuItem template pulls its popup background
             and hover highlight from OS theme brushes, so it ignores the app's dark theme
             unless replaced outright. Two role-specific templates cover the top-level
             headers (File/Tools/Help/VideoCreator, which own the Popup) and their child
             submenu items. -->
        <ControlTemplate x:Key="MenuItemTopLevelHeaderTemplate" TargetType="MenuItem">
            <Border x:Name="Border" Background="{TemplateBinding Background}">
                <Grid>
                    <ContentPresenter Margin="{TemplateBinding Padding}" ContentSource="Header"
                                       RecognizesAccessKey="True" VerticalAlignment="Center"/>
                    <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}"
                           AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1">
                            <ScrollViewer CanContentScroll="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#3F3F46"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="MenuItemTopLevelItemTemplate" TargetType="MenuItem">
            <Border x:Name="Border" Background="{TemplateBinding Background}">
                <ContentPresenter Margin="{TemplateBinding Padding}" ContentSource="Header"
                                   RecognizesAccessKey="True" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#3F3F46"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="MenuItemSubmenuItemTemplate" TargetType="MenuItem">
            <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                   VerticalAlignment="Center" Margin="20,0,8,0"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#3F3F46"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template" Value="{StaticResource MenuItemSubmenuItemTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource MenuItemTopLevelHeaderTemplate}"/>
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Template" Value="{StaticResource MenuItemTopLevelItemTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,4"/>
        </Style>

        <!-- VideoCreator gets its own accent-colored template so it visually stands out from
             the plain File/Tools/Help headers, as a pill-shaped button rather than a flat
             menu item; a lighter shade of the same accent on hover keeps it distinct there too. -->
        <ControlTemplate x:Key="VideoCreatorMenuItemTemplate" TargetType="MenuItem">
            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4" Margin="6,2">
                <ContentPresenter Margin="{TemplateBinding Padding}" ContentSource="Header"
                                   RecognizesAccessKey="True" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#8657E8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="VideoCreatorMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="#6C3CE9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="Template" Value="{StaticResource VideoCreatorMenuItemTemplate}"/>
        </Style>

        <!-- Winamp-style button chrome: a beveled metal cap (light-to-dark gradient, embossed
             top-left highlight) applied to every Button in the window, with the classic
             brighten-on-hover / invert-and-nudge-on-press feedback instead of the flat OS
             button look. Transport buttons additionally swap their text for the classic
             rewind/play/pause/stop/fast-forward glyphs (see the transport bar below). -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#DCEBDD"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bevel" CornerRadius="2" BorderThickness="1" BorderBrush="#0A0A0A">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#6A6A6A" Offset="0"/>
                                    <GradientStop Color="#4A4A4A" Offset="0.45"/>
                                    <GradientStop Color="#2C2C2C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border BorderThickness="1,1,0,0" BorderBrush="#33FFFFFF" CornerRadius="2" Margin="1">
                                <ContentPresenter x:Name="Presenter" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bevel" Property="BorderBrush" Value="#3FB552"/>
                                <Setter TargetName="Bevel" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#7C7C7C" Offset="0"/>
                                            <GradientStop Color="#585858" Offset="0.45"/>
                                            <GradientStop Color="#363636" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bevel" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#222222" Offset="0"/>
                                            <GradientStop Color="#3A3A3A" Offset="0.55"/>
                                            <GradientStop Color="#525252" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Presenter" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="1" Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Winamp graphic-EQ fader: a recessed metal groove with a beveled cap thumb, the same
             gradient language as the Button style above, used by the Equalizer tab's Preamp and
             7 band sliders in place of the transport bar's own implicit Slider style (that one's
             a horizontal green-fill seek/volume look; these are vertical, centered on 0). Keyed
             (not implicit) so it applies only where explicitly requested via Style="", leaving
             SeekSlider/VolumeSlider/KaraokeSlider on their own implicit Slider style below. -->
        <Style x:Key="EqFaderSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Width="6" HorizontalAlignment="Center" CornerRadius="2"
                                    BorderThickness="1" BorderBrush="#0A0A0A">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0C0C0C" Offset="0"/>
                                        <GradientStop Color="#202020" Offset="0.5"/>
                                        <GradientStop Color="#0C0C0C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Rectangle Width="18" Height="1" Fill="#3F6B36" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="26" Height="14" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Cap" CornerRadius="2" BorderThickness="1" BorderBrush="#0A0A0A">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#8C8C8C" Offset="0"/>
                                                            <GradientStop Color="#5C5C5C" Offset="0.5"/>
                                                            <GradientStop Color="#333333" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Rectangle Height="1" Fill="#40FFFFFF" VerticalAlignment="Top" Margin="2,1,2,0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Cap" Property="BorderBrush" Value="#3FB552"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Invisible large-step buttons either side of the Track Separation thumb below: still
             clickable/draggable via the track, just no OS chrome drawn for them. -->
        <Style x:Key="TrackSepRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The classic Winamp EQ slider cap: a squat metallic grip with a few ridge lines,
             beveled light-to-dark top-to-bottom so it reads as a physical, grabbable handle. -->
        <Style x:Key="TrackSepThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Border CornerRadius="1" BorderThickness="1" BorderBrush="#2A2A28">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#EDEDE8" Offset="0"/>
                                        <GradientStop Color="#C2C2BA" Offset="0.42"/>
                                        <GradientStop Color="#8E8E86" Offset="0.55"/>
                                        <GradientStop Color="#6C6C64" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="5,0">
                                <Border Height="1" Background="#55554F" Margin="0,1.5,0,1.5"/>
                                <Border Height="1" Background="#55554F" Margin="0,1.5,0,1.5"/>
                                <Border Height="1" Background="#55554F" Margin="0,1.5,0,1.5"/>
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Winamp-style fader: a recessed green-black groove with tick marks either side and a
             metallic ridged thumb sliding inside it. Built as a vertical slider and then laid on
             its side with a LayoutTransform, which turns the tick marks from left/right into
             above/below and the thumb's ridge lines from horizontal into vertical, for free,
             without a second template, used by the Track Separation tab's 4 faders, which read
             left-to-right rather than the Equalizer tab's up-down bands. -->
        <Style x:Key="TrackSepSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="IsSnapToTickEnabled" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <RotateTransform Angle="90"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                            </Grid.ColumnDefinitions>

                            <TickBar Grid.Column="0" Placement="Left" Fill="#4E5A4E" Width="4"
                                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                     TickFrequency="10" Margin="0,7,0,7"/>

                            <Border Grid.Column="1" Width="8" CornerRadius="2" BorderThickness="1"
                                    BorderBrush="#0A0A0A" HorizontalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#141814" Offset="0"/>
                                        <GradientStop Color="#20261F" Offset="0.5"/>
                                        <GradientStop Color="#0C0F0C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Track Grid.Column="1" x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackSepRepeatButtonStyle}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackSepRepeatButtonStyle}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource TrackSepThumbStyle}"/>
                                </Track.Thumb>
                            </Track>

                            <TickBar Grid.Column="2" Placement="Right" Fill="#4E5A4E" Width="4"
                                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                     TickFrequency="10" Margin="0,7,0,7"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Winamp-style slider chrome: a slim sunken groove, a green fill up to the thumb, and
             a beveled metal thumb, using the same brushed-metal language as the Button style
             above. Applied as an implicit Style (no x:Key), so it covers every Slider in the
             window (SeekSlider, VolumeSlider, KaraokeSlider) automatically, the same way the
             Button style above covers every button without a per-control Style="". -->
        <Style x:Key="WinampSliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Grip" CornerRadius="1" BorderThickness="1" BorderBrush="#0A0A0A">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#8A8A8A" Offset="0"/>
                                    <GradientStop Color="#5A5A5A" Offset="0.5"/>
                                    <GradientStop Color="#333333" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border BorderThickness="1,1,0,0" BorderBrush="#33FFFFFF" CornerRadius="1" Margin="1"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Grip" Property="BorderBrush" Value="#3FB552"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinampSliderFillRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" VerticalAlignment="Center" CornerRadius="1,0,0,1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#3FB552" Offset="0"/>
                                    <GradientStop Color="#1F7A2E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinampSliderTrackRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="6" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="6" VerticalAlignment="Center" CornerRadius="2"
                                    BorderThickness="1" BorderBrush="#0A0A0A" Background="#0A0A0A"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource WinampSliderFillRepeatButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource WinampSliderTrackRepeatButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource WinampSliderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Subtle multimedia-themed background texture. Kept low-opacity, and every panel
             drawn on top uses a slightly translucent background (see tab content below) so
             this shows through everywhere without ever fighting readability. -->
        <Image Source="pack://application:,,,/Resources/background.png" Stretch="UniformToFill" Opacity="0.55"/>

        <DockPanel LastChildFill="True">

            <Grid DockPanel.Dock="Top" Background="#252526" Height="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Menu Grid.Column="0" Background="#252526" Foreground="White">
                    <MenuItem Header="_File" Foreground="White">
                        <MenuItem Header="Add _Video Files..." Click="AddFilesButton_Click"/>
                        <MenuItem Header="Add _Audio Files..." Click="AddAudioFilesButton_Click"/>
                        <MenuItem Header="Add Audio F_older..." Click="AddAudioFolderButton_Click"/>
                        <Separator/>
                        <MenuItem Header="E_xit" Click="ExitMenuItem_Click"/>
                    </MenuItem>
                    <MenuItem Header="_Help" Foreground="White">
                        <MenuItem Header="_About MediaGenie" Click="AboutMenuItem_Click"/>
                    </MenuItem>
                    <MenuItem Header="_VideoCreator" Style="{StaticResource VideoCreatorMenuItemStyle}" Click="VideoCreatorMenuItem_Click"/>
                </Menu>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,3,8,3">
                    <!-- Common mute toggle: applies to whichever engine (LibVLC video or NAudio
                         audio) is behind the currently-active tab, same as VolumeSlider/KaraokeSlider
                         already do; see MuteButton_Click. -->
                    <Button x:Name="MuteButton" Click="MuteButton_Click" Padding="8,2"
                            VerticalAlignment="Center" ToolTip="Mute">
                        <TextBlock x:Name="MuteButtonIcon" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Shared transport bar: drives the Video tab's LibVLC player or the Audio tab's
                 NAudio engine depending which tab is active. Hidden on the Voice Record tab,
                 which has its own Record/Stop controls. -->
            <Border x:Name="TransportBar" DockPanel.Dock="Bottom" Background="#1E1E1E" Padding="12,8"
                    BorderBrush="#3F3F46" BorderThickness="0,1,0,0">
                <StackPanel>
                    <Slider x:Name="SeekSlider" Minimum="0" Maximum="1000" Value="0"
                            PreviewMouseDown="SeekSlider_PreviewMouseDown"
                            PreviewMouseUp="SeekSlider_PreviewMouseUp"
                            Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PrevButton" Grid.Column="0" Content="&#9664;&#9664;" FontSize="11" Click="PrevButton_Click" Padding="10,4" MinWidth="34" Margin="0,0,4,0" ToolTip="Previous"/>
                        <Button x:Name="Back10Button" Grid.Column="1" Content="&#171;&#160;10s" Click="Back10Button_Click" Padding="10,4" Margin="0,0,4,0"/>
                        <Button x:Name="PlayPauseButton" Grid.Column="2" Content="&#9654;" FontSize="13" Click="PlayPauseButton_Click" Padding="14,4" MinWidth="40" Margin="0,0,4,0" ToolTip="Play / Pause"/>
                        <Button x:Name="StopButton" Grid.Column="3" Content="&#9632;" FontSize="12" Click="StopButton_Click" Padding="12,4" MinWidth="36" Margin="0,0,4,0" ToolTip="Stop"/>
                        <Button x:Name="Fwd10Button" Grid.Column="4" Content="10s&#160;&#187;" Click="Fwd10Button_Click" Padding="10,4" Margin="0,0,4,0"/>
                        <Button x:Name="NextButton" Grid.Column="5" Content="&#9654;&#9654;" FontSize="11" Click="NextButton_Click" Padding="10,4" MinWidth="34" Margin="0,0,14,0" ToolTip="Next"/>
                        <TextBlock x:Name="TimeLabel" Grid.Column="6" Text="00:00 / 00:00" Foreground="White" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock x:Name="NowPlayingLabel" Grid.Column="7" Text="No file loaded" Foreground="#AAAAAA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="KaraokeLabel" Grid.Column="8" Text="Karaoke" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"
                                   ToolTip="Fades vocals out of the current Audio track as you lower it (Audio tab only)"/>
                        <Slider x:Name="KaraokeSlider" Grid.Column="9" Width="100" Minimum="0" Maximum="100" Value="100" ValueChanged="KaraokeSlider_ValueChanged" VerticalAlignment="Center" Margin="0,0,14,0"
                                ToolTip="Fades vocals out of the current Audio track as you lower it (Audio tab only)"/>
                        <TextBlock x:Name="VolumeLabel" Grid.Column="10" Text="Vol 100%" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" MinWidth="60"/>
                        <Slider x:Name="VolumeSlider" Grid.Column="11" Width="100" Minimum="0" Maximum="100" Value="100" ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button x:Name="FullscreenButton" Grid.Column="12" Content="Fullscreen" Click="FullscreenButton_Click" Padding="12,4"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0"
                        SelectionChanged="MainTabControl_SelectionChanged">

                <!-- ===================== Video tab ===================== -->
                <TabItem Header="Video">
                    <Grid Background="#1E1E1E">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="FileListColumn" Width="260" MinWidth="0"/>
                            <ColumnDefinition x:Name="SplitterColumn" Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel x:Name="FileListPanel" Grid.Column="0" Background="#E61E1E1E">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
                                <Button x:Name="AddFilesButton" Content="Add Files" Click="AddFilesButton_Click" Padding="8,4" Margin="0,0,6,0"/>
                                <Button x:Name="RemoveFileButton" Content="Remove" Click="RemoveFileButton_Click" Padding="8,4" Margin="0,0,6,0"/>
                                <Button x:Name="ClearAllFilesButton" Content="Clear All" Click="ClearAllFilesButton_Click" Padding="8,4"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Playlist" Foreground="#AAAAAA" Margin="10,0,0,4" FontSize="11"/>
                            <ListBox x:Name="FileListBox"
                                     Margin="8,0,8,8"
                                     ItemsSource="{Binding MediaFiles}"
                                     DisplayMemberPath="DisplayName"
                                     MouseDoubleClick="FileListBox_MouseDoubleClick"
                                     AllowDrop="True"
                                     Drop="FileListBox_Drop"
                                     Background="#252526"
                                     Foreground="White"
                                     BorderThickness="0"/>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#3F3F46"/>

                        <!-- VideoView hosts the video surface as a native child HWND (see LibVLCSharp.WPF's
                             VideoHwndHost), which paints over any ordinary WPF sibling regardless of z-order:
                             the classic "airspace" problem. VideoView works around this itself: content
                             assigned as its Content (not a Grid sibling) is re-hosted onto a transparent,
                             always-aligned topmost window it manages internally (see LibVLCSharp.WPF's
                             ForegroundWindow), which is the only way anything actually renders on top of it. -->
                        <vlc:VideoView x:Name="VideoViewControl" Grid.Column="2" Background="Black" MouseDoubleClick="VideoViewControl_MouseDoubleClick">
                            <!-- Shown whenever nothing is loaded/playing; hidden the moment PlayVideo starts one,
                                 re-shown on Stop or when the playing item is removed. IsHitTestVisible="False" so
                                 double-click (fullscreen) and everything else still reaches the video below. -->
                            <Border x:Name="VideoPlaceholderOverlay" Background="Transparent" IsHitTestVisible="False">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                                    <Grid Width="120" Height="120" Margin="0,0,0,22" HorizontalAlignment="Center" Opacity="0.16">
                                        <Ellipse Stroke="White" StrokeThickness="4"/>
                                        <Polygon Points="46,35 46,85 88,60" Fill="White"/>
                                    </Grid>
                                    <TextBlock Text="MediaGenie" Foreground="White" Opacity="0.55" FontSize="22" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Foreground="White" Opacity="0.4" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16">
                                        Video via LibVLC, audio and voice recording via NAudio, a shared 7-band equalizer with karaoke vocal fade, and a VideoCreator grid tool that combines clips into one video -- or a portrait phone status.
                                    </TextBlock>
                                    <TextBlock Text="Add Video Files, or drop files onto the list, to begin" Foreground="White" Opacity="0.32" FontSize="12"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </vlc:VideoView>
                    </Grid>
                </TabItem>

                <!-- ===================== Audio tab ===================== -->
                <TabItem Header="Audio">
                    <Grid Background="#1E1E1E">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0" Background="#E61E1E1E">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,4">
                                <Button x:Name="AddAudioFilesButton" Content="Add Files" Click="AddAudioFilesButton_Click" Padding="8,4" Margin="0,0,6,0"/>
                                <Button x:Name="AddAudioFolderButton" Content="Add Folder" Click="AddAudioFolderButton_Click" Padding="8,4" Margin="0,0,6,0"/>
                                <Button x:Name="RemoveAudioFileButton" Content="Remove" Click="RemoveAudioFileButton_Click" Padding="8,4" Margin="0,0,6,0"/>
                                <Button x:Name="ClearAllAudioFilesButton" Content="Clear" Click="ClearAllAudioFilesButton_Click" Padding="8,4"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,8,4">
                                <Button x:Name="PlaySelectedAudioButton" Content="Play Selected" Click="PlaySelectedAudioButton_Click" Padding="8,4" Margin="0,0,6,0"/>
                                <Button x:Name="CreatePlaylistButton" Content="Create Playlist" Click="CreatePlaylistButton_Click" Padding="8,4" Margin="0,0,6,0"/>
                                <Button x:Name="LoadPlaylistButton" Content="Load Playlist" Click="LoadPlaylistButton_Click" Padding="8,4"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Select one or more files, then Play or Create Playlist"
                                       Foreground="#AAAAAA" Margin="10,0,8,4" FontSize="11" TextWrapping="Wrap"/>
                            <ListBox x:Name="AudioFileListBox"
                                     Margin="8,0,8,8"
                                     ItemsSource="{Binding AudioFiles}"
                                     DisplayMemberPath="DisplayName"
                                     SelectionMode="Extended"
                                     MouseDoubleClick="AudioFileListBox_MouseDoubleClick"
                                     PreviewMouseRightButtonDown="AudioFileListBox_PreviewMouseRightButtonDown"
                                     AllowDrop="True"
                                     Drop="AudioFileListBox_Drop"
                                     Background="#252526"
                                     Foreground="White"
                                     BorderThickness="0">
                                <ListBox.ContextMenu>
                                    <ContextMenu Background="#252526" Foreground="White">
                                        <MenuItem Header="Save As..." Click="SaveAudioFileAsMenuItem_Click"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#3F3F46"/>

                        <Border Grid.Column="2" Background="#E6141416" BorderBrush="#3F3F46" BorderThickness="2" CornerRadius="8" Margin="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="OSCILLOSCOPE (click to cycle: fire / spectrum / off)" Foreground="#3F6B36" FontSize="11" FontWeight="Bold" Margin="12,10,12,0"/>
                                <controls:OscilloscopeControl x:Name="Oscilloscope" Grid.Row="1" Margin="12"
                                                               Cursor="Hand" ToolTip="Click to switch view"
                                                               MouseLeftButtonDown="OscilloscopeView_MouseLeftButtonDown"/>
                                <controls:OscilloscopeSpectrumControl x:Name="OscilloscopeSpectrum" Grid.Row="1" Margin="12"
                                                                       Visibility="Collapsed"
                                                                       Cursor="Hand" ToolTip="Click to switch view"
                                                                       MouseLeftButtonDown="OscilloscopeView_MouseLeftButtonDown"/>
                                <Border x:Name="OscilloscopeOffPanel" Grid.Row="1" Margin="12" Background="Transparent"
                                        Visibility="Collapsed"
                                        Cursor="Hand" ToolTip="Click to switch view"
                                        MouseLeftButtonDown="OscilloscopeView_MouseLeftButtonDown">
                                    <TextBlock Text="Visualization off &#8212; click to enable" Foreground="#5A6B5C" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ===================== Equalizer tab ===================== -->
                <!-- The same shared 7-band equalizer AudioEngine.ApplyEqualizer/LibVlcEqualizerAdapter
                     already apply to both engines, just embedded here instead of behind the old
                     Preferences dialog, so it can be adjusted live while something keeps playing
                     on the Video or Audio tab, transport bar included (see EffectivePlaybackTabIndex). -->
                <TabItem Header="Equalizer">
                    <Grid Background="#1E1E1E" Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Graphic Equalizer" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <CheckBox x:Name="EqEnabledCheckBox" Content="Enabled" Foreground="White" Margin="20,0,0,0"
                                      VerticalAlignment="Center" Checked="EqControl_Changed" Unchecked="EqControl_Changed"/>
                            <Button x:Name="ResetEqButton" Content="Reset" Padding="8,2" Margin="20,0,0,0" Click="ResetEqButton_Click"/>
                        </StackPanel>

                        <Border Grid.Row="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Preamp -->
                                <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Preamp" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
                                    <Slider x:Name="EqPreampSlider" Style="{StaticResource EqFaderSliderStyle}" Orientation="Vertical" Height="248" Minimum="-12" Maximum="12" Value="0"
                                            TickFrequency="3" IsSnapToTickEnabled="False" ValueChanged="EqSlider_ValueChanged"
                                            Margin="0,8,0,12"/>
                                    <TextBlock x:Name="EqPreampValueLabel" Text="0.0 dB" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- 7 bands -->
                                <UniformGrid Grid.Column="1" Rows="1" Columns="7">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock Text="60 Hz" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
                                        <Slider x:Name="EqBand0Slider" Style="{StaticResource EqFaderSliderStyle}" Orientation="Vertical" Height="248" Minimum="-12" Maximum="12" Value="0"
                                                ValueChanged="EqSlider_ValueChanged" Margin="0,8,0,12"/>
                                        <TextBlock x:Name="EqBand0ValueLabel" Text="0.0 dB" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock Text="310 Hz" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
                                        <Slider x:Name="EqBand1Slider" Style="{StaticResource EqFaderSliderStyle}" Orientation="Vertical" Height="248" Minimum="-12" Maximum="12" Value="0"
                                                ValueChanged="EqSlider_ValueChanged" Margin="0,8,0,12"/>
                                        <TextBlock x:Name="EqBand1ValueLabel" Text="0.0 dB" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock Text="600 Hz" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
                                        <Slider x:Name="EqBand2Slider" Style="{StaticResource EqFaderSliderStyle}" Orientation="Vertical" Height="248" Minimum="-12" Maximum="12" Value="0"
                                                ValueChanged="EqSlider_ValueChanged" Margin="0,8,0,12"/>
                                        <TextBlock x:Name="EqBand2ValueLabel" Text="0.0 dB" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock Text="1 kHz" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
                                        <Slider x:Name="EqBand3Slider" Style="{StaticResource EqFaderSliderStyle}" Orientation="Vertical" Height="248" Minimum="-12" Maximum="12" Value="0"
                                                ValueChanged="EqSlider_ValueChanged" Margin="0,8,0,12"/>
                                        <TextBlock x:Name="EqBand3ValueLabel" Text="0.0 dB" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock Text="3 kHz" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
                                        <Slider x:Name="EqBand4Slider" Style="{StaticResource EqFaderSliderStyle}" Orientation="Vertical" Height="248" Minimum="-12" Maximum="12" Value="0"
                                                ValueChanged="EqSlider_ValueChanged" Margin="0,8,0,12"/>
                                        <TextBlock x:Name="EqBand4ValueLabel" Text="0.0 dB" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock Text="6 kHz" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
                                        <Slider x:Name="EqBand5Slider" Style="{StaticResource EqFaderSliderStyle}" Orientation="Vertical" Height="248" Minimum="-12" Maximum="12" Value="0"
                                                ValueChanged="EqSlider_ValueChanged" Margin="0,8,0,12"/>
                                        <TextBlock x:Name="EqBand5ValueLabel" Text="0.0 dB" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock Text="12 kHz" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
                                        <Slider x:Name="EqBand6Slider" Style="{StaticResource EqFaderSliderStyle}" Orientation="Vertical" Height="248" Minimum="-12" Maximum="12" Value="0"
                                                ValueChanged="EqSlider_ValueChanged" Margin="0,8,0,12"/>
                                        <TextBlock x:Name="EqBand6ValueLabel" Text="0.0 dB" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- Default media folder (moved here from the old Preferences dialog,
                             which had nothing left in it once the equalizer got its own tab). -->
                        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,16,0,0">
                            <TextBlock Text="Default media folder" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="DefaultFolderTextBox" Width="280" Padding="6,4" VerticalContentAlignment="Center"/>
                                <Button Content="Browse..." Padding="10,4" Margin="8,0,0,0" Click="BrowseFolderButton_Click"/>
                                <CheckBox x:Name="ApplyMachineWideCheckBox" Content="Apply for all users"
                                          Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0"
                                          ToolTip="Requires running as administrator. Falls back to just this user if not elevated."/>
                                <Button Content="Save" Padding="10,4" Margin="12,0,0,0" Click="SaveEqualizerAndFolderButton_Click"
                                        ToolTip="Saves the equalizer and default media folder to the registry now (writes the folder machine-wide too if 'Apply for all users' is checked)."/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ===================== Track Separation tab ===================== -->
                <!-- Approximate voice/drums/bass/guitar removal (see InstrumentBandReducerSampleProvider
                     for why it's frequency-band DSP, not true stem isolation) plus a Save-as-MP3
                     export, embedded here instead of a modal window so it can be adjusted while
                     the Audio tab keeps playing. Only meaningful for the NAudio-driven Audio
                     engine, so the transport bar here falls back to whichever of Video/Audio was
                     last actually selected, see EffectivePlaybackTabIndex. -->
                <TabItem x:Name="TrackSeparationTabItem" Header="Track Separation">
                    <Grid Background="#1E1E1E" Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Track Separation" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>

                        <Border Grid.Row="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Voice" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                                <Slider x:Name="TrackSepVoiceSlider" Grid.Row="0" Grid.Column="1" Style="{StaticResource TrackSepSliderStyle}" Height="260"
                                        HorizontalAlignment="Center" ValueChanged="TrackSepSlider_ValueChanged"/>
                                <TextBlock x:Name="TrackSepVoiceValueLabel" Grid.Row="0" Grid.Column="2" Text="0%" Foreground="White" FontSize="12"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Drums" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                                <Slider x:Name="TrackSepDrumsSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource TrackSepSliderStyle}" Height="260"
                                        HorizontalAlignment="Center" ValueChanged="TrackSepSlider_ValueChanged"/>
                                <TextBlock x:Name="TrackSepDrumsValueLabel" Grid.Row="1" Grid.Column="2" Text="0%" Foreground="White" FontSize="12"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Bass" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                                <Slider x:Name="TrackSepBassSlider" Grid.Row="2" Grid.Column="1" Style="{StaticResource TrackSepSliderStyle}" Height="260"
                                        HorizontalAlignment="Center" ValueChanged="TrackSepSlider_ValueChanged"/>
                                <TextBlock x:Name="TrackSepBassValueLabel" Grid.Row="2" Grid.Column="2" Text="0%" Foreground="White" FontSize="12"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Guitar" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                                <Slider x:Name="TrackSepGuitarSlider" Grid.Row="3" Grid.Column="1" Style="{StaticResource TrackSepSliderStyle}" Height="260"
                                        HorizontalAlignment="Center" ValueChanged="TrackSepSlider_ValueChanged"/>
                                <TextBlock x:Name="TrackSepGuitarValueLabel" Grid.Row="3" Grid.Column="2" Text="0%" Foreground="White" FontSize="12"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="TrackSepTrackLabel" Grid.Row="2" Text="No track loaded" Foreground="#AAAAAA" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Margin="0,12,0,0"/>

                        <TextBlock x:Name="TrackSepStatusLabel" Grid.Row="3" Text="" Foreground="#6FBF6F" FontSize="11" Margin="0,4,0,0"/>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="TrackSepSaveButton" Content="Save as MP3..." Padding="12,4" Click="TrackSepSaveButton_Click"/>
                        </StackPanel>

                        <!-- The sliders above are a cheap DSP approximation (frequency-band cuts,
                             see InstrumentBandReducerSampleProvider) that can't cleanly tell voice
                             apart from other center-panned content. This shells out to the
                             external audio-separator tool instead, which wraps an actual trained
                             separation model, genuinely better quality, but offline only (no
                             live preview) and requires Python + audio-separator installed. -->
                        <Border Grid.Row="5" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" Padding="16" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="AI Vocal Separation (higher quality)" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="Uses the audio-separator tool to actually isolate vocals from the rest of the mix, rather than approximating it with the sliders above. Requires Python, with audio-separator installed (pip install &quot;audio-separator[cpu]&quot;)."
                                           Foreground="#AAAAAA" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="AiSeparateButton" Content="Separate with AI..." Padding="12,4" Click="AiSeparateButton_Click"/>
                                    <TextBlock x:Name="AiSeparateStatusLabel" Text="" Foreground="#6FBF6F" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ===================== Voice Record tab ===================== -->
                <TabItem Header="Voice Record">
                    <Grid Background="#1E1E1E">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <Ellipse x:Name="RecordingIndicator" Width="14" Height="14" Fill="#E53935" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0"/>
                                <TextBlock Text="Voice Recorder" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="RecordButton" Content="Record" Width="160" Height="44" FontSize="14"
                                    Click="RecordButton_Click" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock x:Name="RecordingTimeLabel" Text="00:00" Foreground="White" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock x:Name="RecordingStatusLabel"
                                       Text="Press Record to start capturing from your default microphone. The recording is added to the Audio tab automatically when you stop."
                                       Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Transient OSD overlay for volume/seek feedback, faded in/out like VLC's on-screen display -->
        <Border x:Name="OsdBorder" Background="#CC000000" CornerRadius="6" Padding="16,8"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,110"
                Visibility="Collapsed" IsHitTestVisible="False" Opacity="0">
            <TextBlock x:Name="OsdText" Foreground="White" FontSize="16"/>
        </Border>
    </Grid>
</Window>
